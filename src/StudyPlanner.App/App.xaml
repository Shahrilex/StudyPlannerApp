<Application x:Class="StudyPlanner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>

            <FontFamily x:Key="PersianFont">/Fonts/#Vazirmatn</FontFamily>

            <!-- پالت لاکچری: سرمه‌ای عمیق + طلایی + نقره‌ای/دودی + کرم -->
            <Color x:Key="NavyDarkColor">#0B1526</Color>
            <Color x:Key="NavyColor">#152238</Color>
            <Color x:Key="NavyLightColor">#1F3352</Color>
            <Color x:Key="GoldColor">#C9A227</Color>
            <Color x:Key="GoldLightColor">#E4C766</Color>
            <Color x:Key="SilverColor">#B8BCC4</Color>
            <Color x:Key="SilverDarkColor">#8A8F99</Color>
            <Color x:Key="CreamColor">#F3EFE6</Color>

            <SolidColorBrush x:Key="NavyDarkBrush" Color="{StaticResource NavyDarkColor}"/>
            <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}"/>
            <SolidColorBrush x:Key="NavyLightBrush" Color="{StaticResource NavyLightColor}"/>
            <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
            <SolidColorBrush x:Key="GoldLightBrush" Color="{StaticResource GoldLightColor}"/>
            <SolidColorBrush x:Key="SilverBrush" Color="{StaticResource SilverColor}"/>
            <SolidColorBrush x:Key="SilverDarkBrush" Color="{StaticResource SilverDarkColor}"/>
            <SolidColorBrush x:Key="CreamBrush" Color="{StaticResource CreamColor}"/>

            <LinearGradientBrush x:Key="NavyGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource NavyColor}" Offset="0"/>
                <GradientStop Color="{StaticResource NavyDarkColor}" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="GoldGradientBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource GoldColor}" Offset="0"/>
                <GradientStop Color="{StaticResource GoldLightColor}" Offset="1"/>
            </LinearGradientBrush>

            <!-- دکمه‌ی طلایی اصلی -->
            <Style x:Key="GoldButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GoldGradientBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource NavyDarkBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.88"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- دکمه‌ی نقره‌ای ثانویه -->
            <Style x:Key="SilverButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SilverBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource NavyDarkBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Margin" Value="3"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.85"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- سبک پیش‌فرض همه‌ی دکمه‌ها -->
            <Style TargetType="Button" BasedOn="{StaticResource SilverButtonStyle}"/>

            <!-- GroupBox لاکچری -->
            <Style TargetType="GroupBox">
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Grid>
                                <Border Background="{StaticResource CreamBrush}" BorderBrush="{StaticResource GoldBrush}"
                                        BorderThickness="1.5" CornerRadius="6" Margin="0,10,0,0"/>
                                <Border Background="{StaticResource NavyBrush}" CornerRadius="4"
                                        Padding="10,3" HorizontalAlignment="Right" Margin="14,0,0,0" Height="22" VerticalAlignment="Top">
                                    <TextBlock Text="{TemplateBinding Header}" Foreground="{StaticResource GoldLightBrush}" FontWeight="Bold" FontSize="12"/>
                                </Border>
                                <ContentPresenter Margin="12,26,12,12"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- TabControl لاکچری -->
            <Style TargetType="TabItem">
                <Setter Property="Padding" Value="18,10"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabBorder" Background="{StaticResource NavyLightBrush}" CornerRadius="6,6,0,0" Margin="2,0,0,0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource GoldBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="{StaticResource CreamBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource NavyDarkBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TabControl">
                <Setter Property="Background" Value="{StaticResource CreamBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- DataGrid لاکچری -->
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="White"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="AlternatingRowBackground" Value="#F7F4EC"/>
                <Setter Property="BorderBrush" Value="{StaticResource SilverBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#E4E1D8"/>
                <Setter Property="RowHeight" Value="34"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource NavyGradientBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource GoldLightBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="6,8"/>
                <Setter Property="BorderBrush" Value="{StaticResource NavyDarkBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
            </Style>

            <!-- Expander لاکچری -->
            <Style TargetType="Expander">
                <Setter Property="Background" Value="{StaticResource CreamBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource NavyDarkBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="6"/>
            </Style>

            <!-- ListBox داخل TimePicker/سایر پاپ‌آپ‌ها -->
            <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="4,3"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource NavyDarkBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
