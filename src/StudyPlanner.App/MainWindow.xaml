<Window x:Class="StudyPlanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StudyPlanner.App.Controls"
        xmlns:conv="clr-namespace:StudyPlanner.App.Converters"
        xmlns:local="clr-namespace:StudyPlanner.App"
        x:Name="RootWindow"
        Title="برنامه‌ریز مطالعاتی آزمون وکالت/قضاوت"
        Height="880" Width="1500"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource PersianFont}"
        Background="{StaticResource CreamBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:DateTimeToJalaliConverter x:Key="JalaliConverter"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <local:BindingProxy x:Key="ViewModelProxy" Data="{Binding}"/>
    </Window.Resources>

    <Grid>
        <DockPanel>

            <!-- سربرگ -->
            <Border DockPanel.Dock="Top" Background="{StaticResource NavyGradientBrush}" Padding="18,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="برنامه‌ریز مطالعاتی آزمون وکالت / قضاوت" Foreground="{StaticResource GoldLightBrush}"
                                   FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SilverBrush}" FontSize="12"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- بنر یادآوری مرور امروز -->
                    <Border Background="{StaticResource GoldBrush}" CornerRadius="5" Padding="10,5" Margin="0,8,0,0"
                            Visibility="{Binding TodayReviewText, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="{Binding TodayReviewText}" Foreground="{StaticResource NavyDarkBrush}" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- نوار دکمه‌های اصلی -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource NavyBrush}" Padding="8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="ساخت روز جدید" Style="{StaticResource GoldButtonStyle}" Command="{Binding CreateNewDayCommand}"/>
                    <Button Content="افزودن مبحث" Style="{StaticResource SilverButtonStyle}" Command="{Binding AddTopicCommand}"/>
                    <Button Content="کپی مباحث از روز قبل" Style="{StaticResource SilverButtonStyle}" Command="{Binding CopyTopicsFromPreviousDayCommand}"/>
                    <Button Content="افزودن جلسه" Style="{StaticResource SilverButtonStyle}" Command="{Binding AddSessionCommand}"/>
                    <Button Content="خروجی اکسل - همین روز" Style="{StaticResource SilverButtonStyle}" Command="{Binding ExportCurrentDayCommand}"/>
                    <Button Content="خروجی اکسل - همه‌ی روزها" Style="{StaticResource SilverButtonStyle}" Command="{Binding ExportAllDaysCommand}"/>
                    <Separator Margin="6,0" Width="1" Background="{StaticResource SilverDarkBrush}"/>
                    <Button Content="🗄 پشتیبان‌گیری" Style="{StaticResource SilverButtonStyle}" Command="{Binding BackupDatabaseCommand}"/>
                    <Button Content="♻ بازیابی" Style="{StaticResource SilverButtonStyle}" Command="{Binding RestoreDatabaseCommand}"/>
                </StackPanel>
            </Border>

            <!-- پنج تب -->
            <TabControl x:Name="MainTabControl" Margin="10" Background="Transparent" BorderThickness="0">

                <!-- تب تقویم -->
                <TabItem Header="تقویم شمسی">
                    <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Padding="20">
                        <controls:PersianCalendarControl
                            SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                            DatesWithData="{Binding DatesWithData}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                </TabItem>

                <!-- تب مبحث مطالعه -->
                <TabItem Header="مبحث مطالعه">
                    <DataGrid x:Name="TopicsGrid" ItemsSource="{Binding Topics}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CellEditEnding="TopicsGrid_CellEditEnding"
                              PreviewKeyDown="TopicsGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ردیف" Binding="{Binding RowNumber}" IsReadOnly="True" Width="45"/>

                            <DataGridComboBoxColumn Header="عنوان درس"
                                                     SelectedValueBinding="{Binding Subject}"
                                                     SelectedValuePath="Value"
                                                     DisplayMemberPath="Display"
                                                     ItemsSource="{Binding Source={StaticResource ViewModelProxy}, Path=Data.SubjectOptions}"
                                                     Width="140"/>

                            <DataGridTextColumn Header="مبحث مطالعه" Binding="{Binding Topic}" Width="*"/>

                            <DataGridTemplateColumn Header="ساعت شروع" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:PersianTimePickerControl Value="{Binding StartTime, Mode=TwoWay}"
                                            ValueChanged="TopicTimePicker_ValueChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ساعت پایان" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:PersianTimePickerControl Value="{Binding EndTime, Mode=TwoWay}"
                                            ValueChanged="TopicTimePicker_ValueChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="زمان مطالعه (دقیقه)" Binding="{Binding AllocatedMinutes}" IsReadOnly="True" Width="110"/>

                            <DataGridComboBoxColumn Header="اولویت"
                                                     SelectedValueBinding="{Binding Priority}"
                                                     SelectedValuePath="Value"
                                                     DisplayMemberPath="Display"
                                                     ItemsSource="{Binding Source={StaticResource ViewModelProxy}, Path=Data.PriorityOptions}"
                                                     Width="110"/>

                            <DataGridComboBoxColumn Header="سطح تسلط"
                                                     SelectedValueBinding="{Binding Mastery}"
                                                     SelectedValuePath="Value"
                                                     DisplayMemberPath="Display"
                                                     ItemsSource="{Binding Source={StaticResource ViewModelProxy}, Path=Data.MasteryOptions}"
                                                     Width="110"/>

                            <DataGridTextColumn Header="توضیحات" Binding="{Binding Notes}" Width="*"/>

                            <DataGridTemplateColumn Width="35">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Padding="2"
                                                Command="{Binding DataContext.DeleteTopicCommand, ElementName=RootWindow}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- تب جلسات مطالعاتی -->
                <TabItem Header="جلسات مطالعاتی">
                    <DataGrid x:Name="SessionsGrid" ItemsSource="{Binding Sessions}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CellEditEnding="SessionsGrid_CellEditEnding"
                              PreviewKeyDown="SessionsGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="تاریخ" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:PersianDatePickerButton SelectedDate="{Binding Date, Mode=TwoWay}"
                                            DateChanged="SessionDatePicker_DateChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="زمان شروع" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:PersianTimePickerControl Value="{Binding StartTime, Mode=TwoWay}"
                                            ValueChanged="SessionTimePicker_ValueChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="زمان پایان" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:PersianTimePickerControl Value="{Binding EndTime, Mode=TwoWay}"
                                            ValueChanged="SessionTimePicker_ValueChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="مرور اول" Binding="{Binding ReviewDate1, Converter={StaticResource JalaliConverter}}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="مرور دوم" Binding="{Binding ReviewDate2, Converter={StaticResource JalaliConverter}}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="مرور سوم" Binding="{Binding ReviewDate3, Converter={StaticResource JalaliConverter}}" IsReadOnly="True" Width="90"/>

                            <DataGridTemplateColumn Width="35">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Padding="2"
                                                Command="{Binding DataContext.DeleteSessionCommand, ElementName=RootWindow}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- تب جست‌وجوی سراسری -->
                <TabItem Header="جست‌وجو">
                    <DockPanel Margin="4">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="جست‌وجو در متن مبحث، توضیحات یا عنوان درس (حداقل ۲ حرف):"
                                       Foreground="{StaticResource NavyDarkBrush}" FontSize="12" Margin="2,0,0,4"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Top" Background="White" CornerRadius="6" BorderBrush="{StaticResource GoldBrush}"
                                BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" FontSize="15"/>
                        </Border>

                        <ListBox ItemsSource="{Binding SearchResults}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <EventSetter Event="MouseDoubleClick" Handler="SearchResult_MouseDoubleClick"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="6" BorderBrush="{StaticResource SilverBrush}"
                                            BorderThickness="1" Padding="10" Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Topic.Topic}" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="{Binding SubjectDisplayName}" Foreground="{StaticResource SilverDarkBrush}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding JalaliDateText}" Foreground="{StaticResource GoldBrush}"
                                                       FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <!-- تب آمار / داشبورد -->
                <TabItem Header="آمار پیشرفت">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">

                            <Border Background="{StaticResource NavyGradientBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="مجموع زمان مطالعه" Foreground="{StaticResource SilverBrush}" FontSize="13"/>
                                    <TextBlock Foreground="{StaticResource GoldLightBrush}" FontSize="28" FontWeight="Bold">
                                        <Run Text="{Binding TotalMinutesAllTime, Mode=OneWay}"/>
                                        <Run Text=" دقیقه"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="زمان مطالعه به تفکیک درس" FontWeight="Bold" FontSize="15" Foreground="{StaticResource NavyDarkBrush}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding SubjectStats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding SubjectName}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Height="14" Background="#E4E1D8" CornerRadius="7" HorizontalAlignment="Stretch">
                                                <Border Width="{Binding BarWidth}" Height="14" Background="{StaticResource GoldGradientBrush}"
                                                        CornerRadius="7" HorizontalAlignment="Left"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource SilverDarkBrush}">
                                                <Run Text="{Binding TotalMinutes, Mode=OneWay}"/>
                                                <Run Text=" دقیقه"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="توزیع سطح تسلط" FontWeight="Bold" FontSize="15" Foreground="{StaticResource NavyDarkBrush}" Margin="0,20,0,8"/>
                            <ItemsControl ItemsSource="{Binding MasteryStats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding MasteryName}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Height="14" Background="#E4E1D8" CornerRadius="7" HorizontalAlignment="Stretch">
                                                <Border Width="{Binding BarWidth}" Height="14" Background="{StaticResource SilverBrush}"
                                                        CornerRadius="7" HorizontalAlignment="Left"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Count}" Foreground="{StaticResource SilverDarkBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Toast سبک - گوشه‌ی پایین -->
        <Border Background="{StaticResource NavyDarkBrush}" CornerRadius="8" Padding="16,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,70"
                Visibility="{Binding ToastMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource GoldLightBrush}" FontWeight="Bold" FontSize="13"/>
        </Border>
    </Grid>
</Window>
