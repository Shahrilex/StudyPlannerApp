<UserControl x:Class="StudyPlanner.App.Controls.PersianDatePickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StudyPlanner.App.Controls"
             FlowDirection="RightToLeft"
             x:Name="Root">
    <Grid>
        <ToggleButton x:Name="ToggleBtn" Padding="8,4" HorizontalContentAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📅" Margin="4,0,0,0"/>
                <TextBlock x:Name="DisplayText" Margin="4,0,0,0"/>
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=ToggleBtn}"
               IsOpen="{Binding IsChecked, ElementName=ToggleBtn, Mode=TwoWay}"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                <controls:PersianCalendarControl x:Name="Calendar"
                    SelectedDate="{Binding SelectedDate, ElementName=Root, Mode=TwoWay}"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
