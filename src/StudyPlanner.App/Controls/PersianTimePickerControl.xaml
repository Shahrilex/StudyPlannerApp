<UserControl x:Class="StudyPlanner.App.Controls.PersianTimePickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             x:Name="Root">
    <Grid>
        <ToggleButton x:Name="ToggleBtn" Padding="8,4" HorizontalContentAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🕒" Margin="4,0,0,0"/>
                <TextBlock x:Name="DisplayText" Margin="4,0,0,0"/>
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="TimePopup" PlacementTarget="{Binding ElementName=ToggleBtn}"
               IsOpen="{Binding IsChecked, ElementName=ToggleBtn, Mode=TwoWay}"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="ساعت" HorizontalAlignment="Center" FontWeight="Bold" Margin="2"/>
                        <ListBox x:Name="HoursList" Height="150" Width="55" SelectionChanged="HoursList_SelectionChanged"/>
                    </StackPanel>
                    <TextBlock Text=":" VerticalAlignment="Center" FontSize="18" Margin="4,0"/>
                    <StackPanel>
                        <TextBlock Text="دقیقه" HorizontalAlignment="Center" FontWeight="Bold" Margin="2"/>
                        <ListBox x:Name="MinutesList" Height="150" Width="55" SelectionChanged="MinutesList_SelectionChanged"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
